<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Configurations>Release;Debug</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="R2API.Core" Version="5.*" />
		<PackageReference Include="R2API.Networking" Version="1.0.3" />
		<PackageReference Include="R2API.Language" Version="1.0.1" />
		<PackageReference Include="R2API.Prefab" Version="1.*" />
		<PackageReference Include="R2API.Unlockable" Version="1.*" />
		<PackageReference Include="R2API.Sound" Version="1.*" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
		<PackageReference Include="UnityEngine.Modules" Version="2021.3.45" />
		<PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" NoWarn="NU1701" />
		<PackageReference Include="RoR2BepInExPack" Version="1.*" />
	</ItemGroup>
	
  <ItemGroup>
    <EmbeddedResource Include="HenryBank.bnk" />
    <EmbeddedResource Include="linkassets" />
  </ItemGroup>

  <ItemGroup>
	  <Reference Include="CustomEmotesAPI">
		  <HintPath>..\libs\CustomEmotesAPI.dll</HintPath>
	  </Reference>
	  <Reference Include="ExtraSkillSlots">
		  <HintPath>..\libs\ExtraSkillSlots.dll</HintPath>
	  </Reference>
	  <Reference Include="RiskOfOptions">
		  <HintPath>..\libs\RiskOfOptions.dll</HintPath>
	  </Reference>
  </ItemGroup>

</Project>
